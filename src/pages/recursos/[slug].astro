---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { articles, articlePublished, articleRevision, type Article } from '../../data/articles';
import { site } from '../../data/site';
import PageIllustration from '../../components/PageIllustration.astro';
import { illustrationForRoute } from '../../data/illustrations';
export function getStaticPaths() { return articles.map(article => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props as { article: Article };
const published = article.published ?? articlePublished;
const revised = article.revised ?? articleRevision;
---
<Layout title={`${article.title.replace(/\.$/, '')} | MetrilabCL`} description={article.description} type="Article" schema={{ headline: article.title, author: { '@id': `${site.url}/#organization` }, datePublished: published.iso, dateModified: revised.iso }}>
  <nav class="container breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/recursos/">Recursos</a><span aria-hidden="true">/</span><span>{article.category}</span></nav>
  <section class="page-hero page-hero-illustrated"><div class="container page-hero-grid"><div class="page-hero-copy"><p class="eyebrow">{article.category.toUpperCase()} / APOYO PARA TU NEGOCIO</p><h1>{article.title}</h1><p class="lead">{article.description}</p><div class="article-meta"><span>Por Equipo MetrilabCL</span><span>Publicado: {published.label}</span><span>Revisado: {revised.label}</span></div></div><PageIllustration name={illustrationForRoute(Astro.url.pathname)} /></div></section>
  <div class="container page-grid"><aside class="page-sidebar"><p>EN ESTA LECTURA</p><nav aria-label="Secciones de la lectura">{article.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav><a href="/recursos/">← Todos los recursos</a></aside><article class="prose">{article.sections.map(section => <section id={section.id}><h2>{section.title}</h2><div set:html={section.html} /></section>)}<p class="review-date">Equipo MetrilabCL · Revisado: {revised.label}</p></article></div>
  <CTA title="Conversemos sobre tu caso." text="Cuéntanos tu negocio y el apoyo que necesitas. Definamos contigo el siguiente paso y una propuesta de trabajo." href="/contacto/" label="Pedir ayuda a MetrilabCL" />
</Layout>
