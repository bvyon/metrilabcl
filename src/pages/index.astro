---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';

const heroServices = ['Google Ads y Meta Ads', 'Tracking y conversiones', 'Chatbots y CRM en WhatsApp', 'Automatizaciones', 'Piezas y video para anuncios', 'SEO y sitio web'];
const platforms = ['Google Ads', 'Meta Ads', 'Google Analytics 4', 'Google Tag Manager', 'WhatsApp Business API', 'CRM', 'Search Console', 'Píxel de Meta'];
const adPath = ['Búsqueda o feed', 'Anuncio', 'Página', 'WhatsApp'];
const moreServices = [
  { href: '/automatizaciones-funnels/', label: 'Automatización', title: 'Automatizaciones y funnels', text: 'Formularios, CRM y seguimiento conectados para que cada prospecto tenga un siguiente paso.' },
  { href: '/contenidos/', label: 'Contenido', title: 'Textos, gráficas y video', text: 'Textos para tu web y tus anuncios, más gráficas, imágenes y video para campañas y redes sociales.' },
  { href: '/seo/', label: 'Buscadores', title: 'SEO y sitio web', text: 'Base técnica, contenidos y cambios en tu sitio para que te encuentren y funcione como debe.' },
  { href: '/diagnostico/', label: 'Punto de partida', title: 'Diagnóstico', text: 'Una revisión de tu sitio, tus campañas y tu medición, con prioridades claras antes de invertir.' },
];
const work = [
  { sector: 'Salud', title: 'Una clínica', text: 'Estrategia digital completa: campañas, sitio web, piezas para redes y un chatbot en WhatsApp con CRM que agenda horas médicas y responde con la información de la clínica.', tags: ['Google Ads', 'Meta Ads', 'Chatbot', 'CRM', 'Sitio web'] },
  { sector: 'Hogar', title: 'Una empresa de construcción y ampliaciones', text: 'Campañas, cambios en el sitio web y medición de conversiones para ordenar las consultas que llegan desde los anuncios.', tags: ['Google Ads', 'Meta Ads', 'Tracking', 'Sitio web', 'SEO'] },
  { sector: 'Comercio', title: 'Una tienda de materiales de costura', text: 'Campañas, sitio web, SEO y configuración de Google para un emprendimiento que vende materiales para confección.', tags: ['Google Ads', 'Meta Ads', 'SEO', 'Tracking', 'Sitio web'] },
];
const steps = [
  { title: 'Revisamos', text: 'Miramos tus cuentas, tu sitio y tu medición para saber de dónde partimos.' },
  { title: 'Medimos', text: 'Dejamos el tracking y las conversiones funcionando antes de invertir más.' },
  { title: 'Lanzamos', text: 'Campañas y piezas en marcha, con ajustes según lo que muestran los datos.' },
  { title: 'Automatizamos', text: 'WhatsApp, CRM y seguimiento para responder a tiempo cada consulta.' },
];
---
<Layout title="MetrilabCL | Google Ads, Meta Ads, tracking y chatbots de WhatsApp en Chile" description="Agencia de marketing digital en Chile: gestión de Google Ads y Meta Ads, tracking de conversiones, chatbots y CRM en WhatsApp, automatizaciones, contenidos y SEO.">
  <section class="hero" data-section="Inicio">
    <div class="hero-media" aria-hidden="true">
      <div class="hero-dots"></div>
      <div class="hero-video"><video muted loop playsinline preload="none" data-src="/media/hero.mp4" data-src-mobile="/media/hero-mobile.mp4" data-poster="/media/hero-poster.jpg"></video></div>
      <div class="hero-fade"></div>
    </div>
    <div class="container hero-inner">
      <div class="hero-top">
        <ul class="hero-services" data-enter style="--d:.5s">{heroServices.map(service => <li>{service}</li>)}</ul>
        <p class="hero-intro" data-enter style="--d:.6s">Una agencia pequeña a propósito: hablas con quien configura tus campañas.</p>
      </div>
      <div class="hero-bottom">
        <div class="hero-copy">
          <p class="badge" data-enter style="--d:.15s"><span class="status-dot live"></span>Agencia de marketing digital · Chile</p>
          <h1 class="hero-title">
            <span class="line"><span class="word" data-enter style="--d:.25s">Del</span> <span class="word" data-enter style="--d:.35s">clic</span></span>{' '}
            <span class="line"><em><span class="word" data-enter style="--d:.45s">al</span> <span class="word" data-enter style="--d:.55s">cliente.</span></em></span>
          </h1>
          <p class="hero-sub" data-enter style="--d:.7s">Gestionamos tus anuncios en Google y Meta, medimos cada conversión y automatizamos WhatsApp para que ninguna consulta quede sin respuesta.</p>
          <div class="hero-actions" data-enter style="--d:.82s"><a href="/contacto/" class="button button-lime" data-track="cta_click" data-track-detail="Conversemos">Conversemos <Icon name="diagonal" /></a><a href="#anuncios" class="text-link" data-track="cta_click" data-track-detail="Ver cómo funciona">Ver cómo funciona <Icon /></a></div>
        </div>
        <aside class="hero-card glass" data-enter style="--d:.95s" aria-label="Quién está detrás">
          <div class="hero-card-head"><span class="hero-card-mark"><img src="/owl-inverse.svg" width="30" height="28" alt="" /></span><div><b>{site.owner.name}</b><small>Responsable de MetrilabCL</small></div></div>
          <p>Trabajas directo con quien ejecuta: sin intermediarios ni ejecutivos de cuenta.</p>
          <a class="live-chip" href="#medicion"><span><i class="status-dot live"></i>Midiendo esta visita</span><span><span class="live-count">1</span> <span class="live-unit">evento</span></span></a>
        </aside>
      </div>
    </div>
  </section>

  <div class="marquee" role="group" aria-label="Plataformas con las que trabajamos">
    <div class="marquee-track">
      <ul>{platforms.map(platform => <li>{platform}</li>)}</ul>
      <ul aria-hidden="true">{platforms.map(platform => <li>{platform}</li>)}</ul>
    </div>
  </div>

  <section class="section" data-section="Manifiesto">
    <div class="container manifesto-wrap">
      <p class="kicker">Por qué existimos</p>
      <p class="manifesto" data-words>Pagar anuncios es fácil. Lo difícil es saber <em>cuáles traen clientes</em> y responder antes de que se enfríen. Por eso unimos tres cosas que suelen ir separadas: el anuncio, la medición y la conversación.</p>
    </div>
  </section>

  <section class="feature section" id="anuncios" data-section="Anuncios">
    <div class="container feature-grid">
      <div class="feature-copy" data-reveal>
        <p class="kicker">01 · Anuncios</p>
        <h2>Campañas que parten de <em>lo que buscan.</em></h2>
        <p>Gestionamos Google Ads y Meta Ads de punta a punta: estructura, palabras clave, audiencias, presupuesto y optimización. También hacemos las piezas para cada formato.</p>
        <ul class="ticks"><li>Google Ads: búsqueda con palabras clave e intención</li><li>Meta Ads: Facebook e Instagram con piezas propias</li><li>Gráficas, imágenes y video para anuncios y redes</li><li>Cada anuncio apunta a un destino que se puede medir</li></ul>
        <a href="/publicidad-digital/" class="text-link" data-track="cta_click" data-track-detail="Gestión de campañas">Conocer la gestión de campañas <Icon name="diagonal" /></a>
      </div>
      <div class="demo glass ad-demo" data-reveal style="--d:.12s">
        <div class="demo-bar">
          <p class="demo-label">Ejemplo ilustrativo</p>
          <div class="tabs" role="tablist" aria-label="Plataforma del anuncio de ejemplo">
            <button type="button" role="tab" id="tab-google" aria-controls="ad-google" aria-selected="true">Google Ads</button>
            <button type="button" role="tab" id="tab-meta" aria-controls="ad-meta" aria-selected="false" tabindex="-1">Meta Ads</button>
          </div>
        </div>
        <div class="ad-panel" role="tabpanel" id="ad-google" aria-labelledby="tab-google" tabindex="0">
          <p class="ad-search"><Icon name="search" size={16} /> ampliación de casa en iquique</p>
          <p class="ad-sponsor">Patrocinado</p>
          <p class="ad-url">tuempresa.cl › ampliaciones</p>
          <p class="ad-title">Ampliaciones de casa en Iquique | Cotiza por WhatsApp</p>
          <p class="ad-desc">Proyecto, permisos y construcción con un solo equipo. Cuéntanos tu idea y recibe una cotización.</p>
          <ul class="ad-links"><li>Cotizar</li><li>Proyectos</li><li>Cómo trabajamos</li><li>WhatsApp</li></ul>
        </div>
        <div class="ad-panel" role="tabpanel" id="ad-meta" aria-labelledby="tab-meta" tabindex="0" hidden>
          <div class="ad-social">
            <div class="ad-creative"><span>Tu marca</span><b>Lanas nuevas de temporada</b></div>
            <div class="ad-social-copy">
              <p class="ad-sponsor">Tu tienda</p>
              <p class="ad-url">Publicidad · Instagram y Facebook</p>
              <p class="ad-desc">Colores nuevos y envío a todo Chile. Escríbenos y armamos tu pedido en el mismo chat.</p>
              <span class="ad-button">Enviar mensaje</span>
            </div>
          </div>
        </div>
        <ol class="ad-path" aria-label="Recorrido de la persona">{adPath.map((step, i) => <li style={`--i:${i}`}>{step}</li>)}</ol>
        <p class="demo-note">Maqueta con un negocio ficticio. No es un anuncio real ni muestra resultados.</p>
      </div>
    </div>
  </section>

  <section class="feature flip section" id="medicion" data-section="Medición">
    <div class="container feature-grid">
      <div class="feature-copy" data-reveal>
        <p class="kicker">02 · Tracking y conversiones</p>
        <h2>Si no se mide, <em>no se sabe.</em></h2>
        <p>Revisamos y ordenamos la medición de tu sitio: Google Tag Manager, Google Analytics 4 y las conversiones de Google Ads y Meta. Así cada peso invertido se puede comparar con consultas reales.</p>
        <ul class="ticks"><li>Etiquetas y eventos en Google Tag Manager</li><li>Conversiones: formularios, llamadas y clics a WhatsApp</li><li>Google Analytics 4 y Search Console bien configurados</li><li>Comprobación de cada evento antes de darlo por bueno</li></ul>
        <a href="/tracking-conversiones/" class="text-link" data-track="cta_click" data-track-detail="Tracking y conversiones">Conocer el servicio de medición <Icon name="diagonal" /></a>
      </div>
      <div class="demo glass console" data-reveal style="--d:.12s">
        <div class="demo-bar">
          <p class="demo-label"><i class="status-dot live"></i>En vivo · tu visita</p>
          <p class="console-count"><b class="live-count">1</b> <span class="live-unit">evento</span></p>
        </div>
        <ol class="funnel" aria-label="Embudo de esta visita">
          <li data-step="visit" class="done"><span>01</span>Visita</li>
          <li data-step="interest"><span>02</span>Interés</li>
          <li data-step="chat"><span>03</span>Conversación</li>
          <li data-step="conversion"><span>04</span>Conversión</li>
        </ol>
        <ul class="console-log" id="event-log" aria-label="Eventos registrados en esta visita"><li><span>00:00</span><b>page_view</b><i>evento</i></li></ul>
        <div class="console-actions">
          <button type="button" class="chip" data-sim="whatsapp">Simular clic a WhatsApp</button>
          <button type="button" class="chip" data-sim="form">Simular formulario enviado</button>
        </div>
        <p class="demo-note">Esta página se está midiendo a sí misma: recórrela y mira. Es una demostración que solo se muestra en tu pantalla; no envía ni guarda estos eventos.</p>
      </div>
    </div>
  </section>

  <section class="feature section" id="whatsapp" data-section="WhatsApp">
    <div class="container feature-grid">
      <div class="feature-copy" data-reveal>
        <p class="kicker">03 · Chatbots y CRM en WhatsApp</p>
        <h2>Responde y agenda, <em>aunque estés atendiendo.</em></h2>
        <p>Construimos chatbots sobre la API de WhatsApp Business, conectados a un CRM. El asistente responde con la información de tu negocio, agenda horas y deja cada contacto ordenado para tu equipo.</p>
        <ul class="ticks"><li>Respuestas con la información real de tu negocio</li><li>Agenda de horas y derivación a una persona</li><li>CRM con el historial y el estado de cada contacto</li><li>Avisos y seguimiento para que nada se pierda</li></ul>
        <a href="/chatbots-whatsapp/" class="text-link" data-track="cta_click" data-track-detail="Chatbots y CRM">Conocer los chatbots y el CRM <Icon name="diagonal" /></a>
      </div>
      <div class="wa-demo" data-reveal style="--d:.12s">
        <div class="phone">
          <div class="phone-head"><span class="avatar" aria-hidden="true">CD</span><div><b>Clínica Demo</b><small>Asistente automático</small></div></div>
          <div class="chat-thread" id="chat-thread" role="log" aria-live="polite" aria-label="Conversación de demostración" tabindex="0"><p class="bubble bot">Hola, soy el asistente de Clínica Demo. ¿En qué te ayudo?</p></div>
          <div class="chat-options" id="chat-options" role="group" aria-label="Respuestas rápidas"></div>
        </div>
        <div class="crm glass">
          <p class="demo-label">CRM · estado del contacto</p>
          <div class="crm-cols">
            <div class="crm-col" data-col="new"><p class="crm-title">Nuevo</p><div class="crm-card" id="crm-card"><b>Visitante de la demo</b><span id="crm-last">Aún no escribe</span><i id="crm-tag">Canal: WhatsApp</i></div></div>
            <div class="crm-col" data-col="talking"><p class="crm-title">En conversación</p></div>
            <div class="crm-col" data-col="booked"><p class="crm-title">Agendado</p></div>
          </div>
          <p class="demo-note">Demostración guiada con datos ficticios. Elige una respuesta y mira cómo se mueve el contacto.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="servicios" data-section="Servicios">
    <div class="container">
      <header class="section-head" data-reveal><div><p class="kicker">04 · Más servicios</p><h2>Lo demás que <em>sostiene el sistema.</em></h2></div><p>El alcance se arma según tu negocio. Estos servicios se contratan solos o como parte del trabajo completo.</p></header>
      <div class="svc-grid">{moreServices.map((service, i) => <a href={service.href} class="svc-card spot" data-reveal style={`--d:${i * 0.08}s`} data-track="cta_click" data-track-detail={service.title}><span class="eyebrow">{service.label}</span><h3>{service.title}</h3><p>{service.text}</p><span class="card-link">Ver servicio <Icon name="diagonal" size={18} /></span></a>)}</div>
    </div>
  </section>

  <section class="sheet section" id="trabajo" data-section="Trabajo">
    <div class="container">
      <header class="section-head" data-reveal><div><p class="kicker">Trabajo en curso</p><h2>Esto es lo que <em>hacemos hoy.</em></h2></div><p>Tres rubros distintos, el mismo sistema: anuncios, medición y respuesta.</p></header>
      <div class="work-grid">{work.map((item, i) => <article class="work-card" data-reveal style={`--d:${i * 0.08}s`}><p class="eyebrow"><span>{item.sector}</span><span>0{i + 1}</span></p><h3>{item.title}</h3><p>{item.text}</p><ul class="work-tags">{item.tags.map(tag => <li>{tag}</li>)}</ul></article>)}</div>
      <p class="work-note" data-reveal>Sin nombres ni cifras en público: los detalles se conversan cuando cada cliente lo autoriza.</p>
      <div class="process">
        <header class="section-head" data-reveal><div><p class="kicker">Cómo trabajamos</p><h2>Primero medir. <em>Después acelerar.</em></h2></div><p><a href="/metodo/" class="text-link">Ver el método completo <Icon name="diagonal" /></a></p></header>
        <ol class="steps">{steps.map((step, i) => <li data-reveal style={`--d:${i * 0.08}s`}><span aria-hidden="true">0{i + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      </div>
    </div>
  </section>

  <section class="studio section" id="estudio" data-section="Estudio">
    <div class="container studio-grid">
      <div class="studio-figure" data-reveal><p class="count-wrap"><span class="count" data-count="7">7</span><i aria-hidden="true">+</i></p><p>años en publicidad y estrategia digital</p></div>
      <div class="studio-copy" data-reveal style="--d:.1s">
        <p class="kicker">Quién está detrás</p>
        <h2>Una agencia con <em>nombre y apellido.</em></h2>
        <p>MetrilabCL está a cargo de {site.owner.name}. Él planifica, configura y revisa tus campañas, tu medición y tus automatizaciones; por eso siempre sabes con quién hablar y quién responde por el trabajo.</p>
        <div class="studio-links"><a href="/nosotros/" class="text-link">Conocer el estudio <Icon name="diagonal" /></a><a href={site.owner.linkedin} class="text-link" rel="me noopener">LinkedIn <Icon name="diagonal" /></a></div>
        <p class="promise"><strong>Prometemos trabajo que se puede revisar.</strong> No prometemos posiciones en Google ni ventas garantizadas: eso depende de factores que ninguna agencia controla.</p>
      </div>
    </div>
  </section>

  <CTA title="¿Conversamos sobre tu negocio?" text="Cuéntanos qué vendes, cómo te llegan hoy las consultas y qué te gustaría mejorar. Respondemos con un siguiente paso concreto." href="/contacto/" label="Escribir a MetrilabCL" />

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Video del encabezado, alojado en el sitio. Con movimiento reducido o ahorro de datos se muestra una imagen fija.
    const video = document.querySelector<HTMLVideoElement>('.hero-video video');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (video?.dataset.src) {
      const show = () => video.parentElement?.classList.add('is-ready');
      if (reduced || saveData) {
        const still = new Image();
        still.addEventListener('load', () => { video.poster = still.src; show(); }, { once: true });
        still.src = video.dataset.poster!;
      } else {
        video.addEventListener('loadeddata', show, { once: true });
        // Si el navegador no puede reproducir el archivo, queda la imagen fija.
        video.addEventListener('error', () => { video.poster = video.dataset.poster!; show(); }, { once: true });
        video.src = window.matchMedia('(min-width: 768px)').matches ? video.dataset.src : video.dataset.srcMobile!;
        video.play().catch(() => {});
      }
    }

    // Medición en vivo: registra en pantalla lo que ocurre en esta visita. No envía nada.
    const started = performance.now();
    const log = document.querySelector<HTMLElement>('#event-log');
    const counters = document.querySelectorAll<HTMLElement>('.live-count');
    const units = document.querySelectorAll<HTMLElement>('.live-unit');
    let total = 0;
    const clock = () => {
      const seconds = Math.floor((performance.now() - started) / 1000);
      return `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
    };
    const reach = (step: string) => document.querySelector(`.funnel [data-step="${step}"]`)?.classList.add('done');
    const track = (name: string, detail = '', conversion = false) => {
      total += 1;
      counters.forEach((counter) => { counter.textContent = String(total); });
      units.forEach((unit) => { unit.textContent = total === 1 ? 'evento' : 'eventos'; });
      if (!log) return;
      const row = document.createElement('li');
      if (conversion) row.classList.add('is-conversion');
      const time = document.createElement('span');
      time.textContent = clock();
      const label = document.createElement('b');
      label.textContent = detail ? `${name} · ${detail}` : name;
      const kind = document.createElement('i');
      kind.textContent = conversion ? 'conversión' : 'evento';
      row.append(time, label, kind);
      log.prepend(row);
      while (log.children.length > 5) log.lastElementChild?.remove();
    };
    if (log) log.textContent = '';
    track('page_view', 'Portada');

    const depths = [25, 50, 75, 90];
    let sectionsSeen = 0;
    const onDepth = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (max <= 0) return;
      const percent = (window.scrollY / max) * 100;
      while (depths.length && percent >= depths[0]) {
        const depth = depths.shift()!;
        track('scroll', `${depth} %`);
        if (depth >= 50) reach('interest');
      }
    };
    window.addEventListener('scroll', onDepth, { passive: true });
    const sections = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        sections.unobserve(entry.target);
        const name = (entry.target as HTMLElement).dataset.section || '';
        if (name === 'Inicio') continue;
        track('section_view', name);
        sectionsSeen += 1;
        if (sectionsSeen >= 3) reach('interest');
      }
    }, { threshold: 0.35 });
    document.querySelectorAll('[data-section]').forEach((section) => sections.observe(section));
    document.querySelectorAll<HTMLElement>('[data-track]').forEach((element) => element.addEventListener('click', () => track(element.dataset.track!, element.dataset.trackDetail)));
    document.querySelector('[data-sim="whatsapp"]')?.addEventListener('click', () => { track('whatsapp_click', 'Botón de contacto'); reach('chat'); });
    document.querySelector('[data-sim="form"]')?.addEventListener('click', () => { track('generate_lead', 'Formulario', true); reach('chat'); reach('conversion'); });

    // Pestañas de la maqueta de anuncios.
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs [role="tab"]')];
    const selectTab = (tab: HTMLButtonElement, focus = false) => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute('aria-selected', String(selected));
        other.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(other.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !selected;
      }
      if (focus) tab.focus();
      track('ad_preview', tab.textContent || '');
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => { if (tab.getAttribute('aria-selected') !== 'true') selectTab(tab); });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        selectTab(tabs[(index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      });
    });

    // Chat de demostración con respuestas guiadas y tablero CRM.
    type Option = { label: string; next: string };
    type Step = { say: (context: Record<string, string>) => string; options: Option[]; enter?: (context: Record<string, string>) => void; remember?: string };
    const thread = document.querySelector<HTMLElement>('#chat-thread');
    const optionsBox = document.querySelector<HTMLElement>('#chat-options');
    const card = document.querySelector<HTMLElement>('#crm-card');
    const lastMessage = document.querySelector<HTMLElement>('#crm-last');
    const tag = document.querySelector<HTMLElement>('#crm-tag');
    const moveCard = (column: string, label: string) => {
      const target = document.querySelector(`.crm-col[data-col="${column}"]`);
      if (card && target && card.parentElement !== target) target.append(card);
      if (tag) tag.textContent = label;
    };
    const restart: Option = { label: 'Reiniciar demostración', next: 'start' };
    const flow: Record<string, Step> = {
      start: { say: () => 'Hola, soy el asistente de Clínica Demo. ¿En qué te ayudo?', options: [{ label: 'Agendar una hora', next: 'specialty' }, { label: 'Horarios y ubicación', next: 'hours' }, { label: 'Hablar con una persona', next: 'human' }] },
      specialty: { say: () => 'Claro. ¿Qué especialidad necesitas?', options: [{ label: 'Medicina general', next: 'slots' }, { label: 'Kinesiología', next: 'slots' }, { label: 'Odontología', next: 'slots' }] },
      slots: { remember: 'specialty', say: (context) => `Para ${context.specialty.toLowerCase()} tengo estas horas disponibles:`, options: [{ label: 'Mañana, 10:30', next: 'booked' }, { label: 'Jueves, 16:00', next: 'booked' }] },
      booked: { remember: 'slot', say: (context) => `Listo. Reservé tu hora de ${context.specialty.toLowerCase()} para ${context.slot.toLowerCase()}. Te enviaré un recordatorio el día anterior.`, options: [restart], enter: () => { moveCard('booked', 'Hora agendada'); track('booking_complete', 'Hora agendada', true); reach('conversion'); } },
      hours: { say: () => 'Atendemos de lunes a viernes de 8:30 a 19:00 y los sábados de 9:00 a 13:00. ¿Quieres agendar una hora?', options: [{ label: 'Agendar una hora', next: 'specialty' }, { label: 'Hablar con una persona', next: 'human' }] },
      human: { say: () => 'Te derivo con recepción. Tu consulta queda registrada para que te respondan en este mismo chat.', options: [restart], enter: () => { moveCard('talking', 'Derivado a recepción'); track('human_handoff', 'Recepción'); } },
    };
    const context: Record<string, string> = {};
    const bubble = (text: string, who: 'bot' | 'user') => {
      const element = document.createElement('p');
      element.className = `bubble ${who}`;
      element.textContent = text;
      thread?.append(element);
      if (thread) thread.scrollTop = thread.scrollHeight;
      return element;
    };
    const showOptions = (step: Step) => {
      if (!optionsBox) return;
      optionsBox.textContent = '';
      for (const option of step.options) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'chip';
        button.textContent = option.label;
        button.addEventListener('click', () => choose(option));
        optionsBox.append(button);
      }
    };
    let chatStarted = false;
    const choose = (option: Option) => {
      if (!thread || !optionsBox) return;
      optionsBox.textContent = '';
      if (option.next === 'start') {
        thread.textContent = '';
        moveCard('new', 'Canal: WhatsApp');
        if (lastMessage) lastMessage.textContent = 'Aún no escribe';
        chatStarted = false;
        bubble(flow.start.say(context), 'bot');
        showOptions(flow.start);
        track('chat_restart');
        return;
      }
      const step = flow[option.next];
      if (step.remember) context[step.remember] = option.label;
      bubble(option.label, 'user');
      if (lastMessage) lastMessage.textContent = `«${option.label}»`;
      if (!chatStarted) { chatStarted = true; track('chat_start', 'WhatsApp'); reach('chat'); moveCard('talking', 'Respondido por el asistente'); }
      else track('chat_reply', option.label);
      const answer = () => { step.enter?.(context); bubble(step.say(context), 'bot'); showOptions(step); };
      if (reduced) { answer(); return; }
      const typing = document.createElement('p');
      typing.className = 'bubble bot typing';
      typing.setAttribute('aria-hidden', 'true');
      typing.append(document.createElement('i'), document.createElement('i'), document.createElement('i'));
      thread.append(typing);
      thread.scrollTop = thread.scrollHeight;
      window.setTimeout(() => { typing.remove(); answer(); }, 750);
    };
    showOptions(flow.start);

    // Manifiesto: las palabras se iluminan con el avance del scroll.
    const manifesto = document.querySelector<HTMLElement>('[data-words]');
    if (manifesto && !reduced) {
      const words: HTMLElement[] = [];
      const split = (node: Node) => {
        for (const child of [...node.childNodes]) {
          if (child.nodeType === Node.TEXT_NODE) {
            const fragment = document.createDocumentFragment();
            for (const part of (child.textContent || '').split(/(\s+)/)) {
              if (!part.trim()) { fragment.append(part); continue; }
              const word = document.createElement('span');
              word.className = 'w';
              word.textContent = part;
              words.push(word);
              fragment.append(word);
            }
            child.replaceWith(fragment);
          } else split(child);
        }
      };
      split(manifesto);
      let lit = -1;
      const paint = () => {
        const box = manifesto.getBoundingClientRect();
        const progress = Math.min(1, Math.max(0, (window.innerHeight * 0.85 - box.top) / (window.innerHeight * 0.5 + box.height)));
        const count = Math.round(progress * words.length);
        if (count === lit) return;
        lit = count;
        words.forEach((word, index) => word.classList.toggle('on', index < count));
      };
      window.addEventListener('scroll', paint, { passive: true });
      window.addEventListener('resize', paint);
      paint();
    }

    // Contador de años.
    const counter = document.querySelector<HTMLElement>('.count[data-count]');
    if (counter && !reduced) {
      const goal = Number(counter.dataset.count);
      const watch = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        watch.disconnect();
        const begin = performance.now();
        const tick = (now: number) => {
          const progress = Math.min(1, (now - begin) / 1400);
          counter.textContent = String(Math.round(goal * (1 - Math.pow(1 - progress, 3))));
          if (progress < 1) requestAnimationFrame(tick);
        };
        counter.textContent = '0';
        requestAnimationFrame(tick);
      }, { threshold: 0.5 });
      watch.observe(counter);
    }
  </script>
</Layout>
