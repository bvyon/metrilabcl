---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { pages, type Page } from '../data/pages';
import { site } from '../data/site';
export function getStaticPaths() { return pages.map(page => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props as { page: Page };
const schema = page.service ? {
  mainEntity: { '@type': 'Service', name: page.breadcrumb, description: page.lead, provider: { '@id': `${site.url}/#organization` }, areaServed: { '@type': 'Country', name: 'Chile' }, serviceType: page.breadcrumb },
} : page.type === 'AboutPage' ? { about: { '@id': `${site.url}/#organization` } } : undefined;
---
<Layout title={page.seoTitle} description={page.description} type={page.type} schema={schema}>
  <PageHero title={page.title} label={page.label} lead={page.lead} breadcrumb={page.breadcrumb} contact={page.contact} />
  <div class="container page-grid"><aside class="page-sidebar"><p>EN ESTA PÁGINA</p><nav aria-label="Secciones de la página">{page.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav></aside><article class="prose">{page.sections.map(section => <section id={section.id}><h2>{section.title}</h2><div set:html={section.html} /></section>)}<div class="review-date">Equipo MetrilabCL · Versión editorial: 10 de octubre de 2026</div></article></div>
  {page.contact !== false && <CTA subject={`Consulta desde ${page.breadcrumb} | MetrilabCL`} />}
</Layout>
