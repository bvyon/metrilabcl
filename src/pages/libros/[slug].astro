---
import Base from '../../layouts/Base.astro'
import { cargarLibros, cargarAutor, type Libro, type Autor } from '../../lib/catalogo'
import { SITIO, S, fecha, fechaHora, idiomaDelTitulo } from '../../lib/sitio'
import { ldFicha } from '../../lib/jsonld'

export async function getStaticPaths() {
  const libros = await cargarLibros()
  const autor = await cargarAutor(libros)
  return libros.map((b) => ({
    params: { slug: b.slug },
    props: { b, otros: libros.filter((o) => o.slug !== b.slug), autor },
  }))
}

interface Props {
  b: Libro
  otros: Libro[]
  autor: Autor
}
const { b, otros, autor } = Astro.props

const ruta = `/${SITIO.catalogPathSegment}/${b.slug}/`
const canonical = new URL(ruta, Astro.site!).href
const urlIndice = new URL('/', Astro.site!).href

// La meta description usa el titulo hasta los dos puntos: el titulo completo de un libro de
// KDP pasa de 100 caracteres y la descripcion saldria cortada en el resultado de busqueda.
// El <title> si lleva el titulo completo: ahi el dato real manda sobre la longitud ideal.
const tituloCorto = b.title.split(':')[0].trim().slice(0, 60)

// Una ficha lleva `measurement` (leida de Amazon) o `declaration` (entregada por escrito por el
// propietario del catalogo); el esquema garantiza que sea exactamente una. La declarada no tiene
// ni un campo medido, asi que ni su <title>, ni su descripcion, ni sus datos pueden fingir uno.
const m = b.measurement
const decl = b.declaration
const description = m
  ? S.fichaDescripcion(
      tituloCorto, b.author, b.format!, b.printLength!, b.language!,
      fecha(b.publicationDate!), b.asin, m.measuredAt.slice(0, 10),
    )
  : S.fichaDescripcionDeclarada(tituloCorto, b.author, b.asin, fecha(decl!.declaredAt.slice(0, 10)))

const d = b.demandContext
---

<Base
  ruta={ruta}
  title={S.fichaTitulo(b.title, b.asin)}
  description={description}
  bodyClass="p-ficha"
  jsonLd={ldFicha(canonical, b, urlIndice)}
>
  <nav class="migas" aria-label={S.rutaLabel}>
    <a href="/">{S.migaCatalogo}</a> › <span aria-current="page">{b.asin}</span>
  </nav>
  <h1 lang={idiomaDelTitulo(b)}>{b.title}</h1>
  <p class="entrada">{m ? S.fichaEntrada(b.author) : S.fichaEntradaDeclarada(b.author)}</p>
  {!m && <p class="aviso">{S.fichaAvisoDeclarada}</p>}

  <h2>{S.h2Datos}</h2>
  <dl class="datos datos-ficha">
    <dt>{S.dtAutor}</dt>
    <dd>{b.author}</dd>
    <dt>{S.dtFormato}</dt>
    <dd>{b.format ?? <span class="no-medido-inline">{S.noMedido}</span>}</dd>
    <dt>{S.dtIdioma}</dt>
    <dd>{b.language ?? <span class="no-medido-inline">{S.noMedido}</span>}</dd>
    <dt>{S.dtExtension}</dt>
    <dd>{b.printLength ? S.paginas(b.printLength) : <span class="no-medido-inline">{S.noMedido}</span>}</dd>
    <dt>{S.dtFechaPublicacion}</dt>
    <dd>
      {
        b.publicationDate ? (
          <time datetime={b.publicationDate}>{fecha(b.publicationDate)}</time>
        ) : (
          <span class="no-medido-inline">{S.noMedido}</span>
        )
      }
    </dd>
    <dt>{S.dtAsin}</dt>
    <dd><code>{b.asin}</code></dd>
    {b.fileSize && <><dt>{S.dtPeso}</dt><dd>{b.fileSize}</dd></>}
    {
      b.price ? (
        <>
          <dt>{S.dtPrecio}</dt>
          <dd>
            {b.price.currency} {b.price.amount} <span class="nota-inline">{S.precioNota}</span>
          </dd>
        </>
      ) : (
        // En una ficha declarada la fila del precio se emite VACIA y marcada, no se omite: un
        // precio ausente en silencio se lee como "gratis" o como una pagina a medio hacer.
        !m && (
          <>
            <dt>{S.dtPrecioNeutro}</dt>
            <dd><span class="no-medido-inline">{S.noMedido}</span></dd>
          </>
        )
      )
    }
  </dl>

  <p class="cta">
    <a class="boton" href={b.amazonUrl} rel="external nofollow">{S.cta}</a>
  </p>

  {
    d && (
      <>
        <h2>{S.h2Demanda}</h2>
        <p>{S.demandaIntro(d.source.label, fecha(d.source.readAt))}</p>
        <ul class="preguntas">
          {d.questions.map((q) => <li lang={d.questionsLang}>{q}</li>)}
        </ul>
        <p class="aviso">{S.demandaAviso}</p>
        {d.notes?.map((n) => <p class="nota">{n}</p>)}
        <p class="procedencia">
          {S.demandaFuente(d.source.url)} — {d.source.method} {d.source.readBy}
        </p>
      </>
    )
  }

  {
    b.relatedEditions && (
      <>
        <h2>{S.h2OtrasEdiciones}</h2>
        <ul class="no-medido">
          {
            b.relatedEditions.map((e) => (
              <li>
                {e.format} — <code>{e.asin}</code>,{' '}
                <a href={e.url} rel="external nofollow">{e.storefront}</a>. {e.note}
              </li>
            ))
          }
        </ul>
      </>
    )
  }

  <h2>{S.h2MasDelAutor}</h2>
  {
    otros.length ? (
      <>
        <p>{S.masDelAutorTexto(autor.primaryName)}</p>
        <ul class="enlaces">
          {
            otros.map((o) => (
              <li>
                <a href={`/${SITIO.catalogPathSegment}/${o.slug}/`} lang={idiomaDelTitulo(o)}>
                  {o.title}
                </a>
              </li>
            ))
          }
        </ul>
        <p><a href={`/${SITIO.authorPathSegment}/`}>{S.verPaginaAutor}</a></p>
      </>
    ) : (
      <p
        set:html={S.masDelAutorSinOtros(
          autor.primaryName,
          `<a href="/${SITIO.authorPathSegment}/">${S.verPaginaAutor}</a>`,
        )}
      />
    )
  }

  <h2>{S.h2Procedencia}</h2>
  {
    m ? (
      <dl class="datos procedencia-dl">
        <dt>{S.dtFuente}</dt>
        <dd>{m.source} — <span class="url">{m.sourceUrl}</span></dd>
        <dt>{S.dtMedidoEl}</dt>
        <dd>
          <time datetime={m.measuredAt}>{fechaHora(m.measuredAt)}</time>
        </dd>
        <dt>{S.dtMedidoPor}</dt>
        <dd>{m.measuredBy}</dd>
        <dt>{S.dtMetodo}</dt>
        <dd>{m.method}</dd>
        {
          m.verifiedAt && (
            <>
              <dt>{S.dtReverificado}</dt>
              <dd>
                <time datetime={m.verifiedAt}>{fechaHora(m.verifiedAt)}</time>
                {m.verifiedBy && ` — ${m.verifiedBy}`}
              </dd>
            </>
          )
        }
      </dl>
    ) : (
      <dl class="datos procedencia-dl">
        <dt>{S.dtFuente}</dt>
        <dd>{decl!.source}</dd>
        <dt>{S.dtDeclaradoEl}</dt>
        <dd>
          <time datetime={decl!.declaredAt}>{fechaHora(decl!.declaredAt)}</time>
        </dd>
        <dt>{S.dtDeclaradoPor}</dt>
        <dd>{decl!.declaredBy}</dd>
        <dt>{S.dtDeclaraQue}</dt>
        <dd>
          <ul class="declara">{decl!.declares.map((x) => <li>{x}</li>)}</ul>
        </dd>
        <dt>{S.dtMetodo}</dt>
        <dd>{decl!.method}</dd>
      </dl>
    )
  }

  {
    b.observations && (
      <>
        <h2>{S.h2Anomalias}</h2>
        <ul class="no-medido">{b.observations.map((x) => <li>{x}</li>)}</ul>
      </>
    )
  }

  {
    b.notMeasured && (
      <>
        <h2>{S.h2NoMedido}</h2>
        <ul class="no-medido">{b.notMeasured.map((x) => <li>{x}</li>)}</ul>
      </>
    )
  }
</Base>
