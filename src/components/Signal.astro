---
import { Image } from 'astro:assets';
import claridad from '../assets/illustrations/claridad.png';
---
<figure class="hero-art">
  <div class="hero-art-top"><span><i></i> UNA MIRADA CON CRITERIO</span><span>FIG. 01</span></div>
  <Image src={claridad} alt="Una lupa enfoca las capas de una web, conectadas con señales de búsqueda: investigar permite ver qué mejorar." width={960} widths={[400, 640, 960]} sizes="(max-width: 650px) calc(100vw - 40px), (max-width: 900px) 45vw, 40vw" format="webp" quality={82} loading="eager" fetchpriority="high" />
  <figcaption class="hero-art-caption"><span><b>01</b> Lo que buscan</span><span><b>02</b> Lo que respondes</span><span><b>03</b> Tu siguiente paso</span></figcaption>
</figure>
